{
  "name": "trove",
  "version": "0.1.0",
  "description": "Trove — a fast file explorer for Windows, macOS and Linux, built with Tauri 2 + Svelte 5",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo \"\"; bun scripts/install-git-hook.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gate:fe": "bun run check && bun run lint && bun run test && bun run build",
    "gate:rs": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "gate": "bun run gate:fe && bun run gate:rs",
    "bump-version": "bun scripts/bump-version.ts",
    "tauri": "tauri",
    "test": "vitest run",
    "build:exe": "tauri build --no-bundle",
    "build:installer": "tauri build --bundles nsis",
    "build:screen": "tauri build --config src-tauri/tauri.screen.conf.json"
  },
  "license": "MIT",
  "packageManager": "bun@1.2.15",
  "dependencies": {
    "@tanstack/svelte-virtual": "^3.13.39",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.9.2",
    "@tauri-apps/plugin-opener": "^2",
    "@wterm/dom": "^0.5.0",
    "@wterm/svelte": "^0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
