{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trove",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 17 },
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" },
        "shadow": true
      },
      {
        "label": "palette",
        "title": "Spotlight",
        "url": "/palette",
        "width": 680,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"]
  }
}
