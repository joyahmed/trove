{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trove",
  "version": "0.1.0",
  "identifier": "com.joyahmed.trove",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trove",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "palette",
        "title": "Spotlight",
        "url": "/palette",
        "width": 680,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "longDescription": "Trove is a fast file explorer for Windows, Mac and Linux. It has real tabs, stays quick in folders with 100,000 files, and has a search that finds files by name at once.",
    "resources": {
      "../LICENSES/": "LICENSES/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
